{% extends 'base.html.twig' %}

{% block title %}Wpisy{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="page-heading">Twoje wpisy</h1>
            <p class="page-description mb-sm-0">Zapisuj pomysły i wracaj do nich, kiedy chcesz.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_post_new') }}">Dodaj wpis</a>
    </div>

    <section aria-labelledby="entries-heading">
        <h2 class="h5 mb-3" id="entries-heading">Ostatnie wpisy <span class="text-body-secondary fw-normal">({{ posts|length }})</span></h2>

        {% if posts is empty %}
            <div class="empty-state text-center">
                <h3 class="h5">Nie ma jeszcze wpisów</h3>
                <p class="text-body-secondary">Utwórz pierwszy wpis, aby zacząć.</p>
                <a class="btn btn-primary" href="{{ path('app_post_new') }}">Utwórz wpis</a>
            </div>
        {% else %}
            <div class="row g-3">
                {% for post in posts %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card post-card">
                            <div class="card-body">
                                <h3 class="card-title h5">
                                    <a href="{{ path('app_post_show', {'id': post.id}) }}">{{ post.subject }}</a>
                                </h3>
                                <p class="post-description">{{ post.description }}</p>
                                <div class="post-actions">
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_post_show', {'id': post.id}) }}">Czytaj</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_post_edit', {'id': post.id}) }}">Edytuj</a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ post.subject }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <a class="btn btn-outline-secondary" href="{{ path('app_post_index') }}">Wróć do wpisów</a>
        <div class="form-actions">
            <a class="btn btn-outline-primary" href="{{ path('app_post_edit', {'id': post.id}) }}">Edytuj wpis</a>
            {{ include('post/_delete_form.html.twig') }}
        </div>
    </div>

    <article class="reading-panel mx-auto">
        <h1 class="reading-title">{{ post.subject }}</h1>
        <div class="reading-copy">{{ post.description }}</div>
    </article>
{% endblock %}
